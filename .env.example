# The agent's wallet private key (0x-prefixed, 64 hex chars).
# Use a DEDICATED wallet holding only what you intend to spend — never your main wallet.
# The wallet needs USDp, USDC or sUSDp on the target chain. No ETH/gas required: settlement is relayed.
AGENT_PRIVATE_KEY=

# Hard cap on what a single request may cost, in token units (default: 1).
# The agent refuses any invoice above this before signing anything.
MAX_AMOUNT=1

# Optional overrides (defaults shown):
# MERCHANT_URL=https://api.parallel.best
# ENDPOINT=/public/x402/base/snapshot
# CHAIN=base                # base | avalanche | hyperevm | ethereum
# PAY_WITH=usdp             # usdp | usdc | susdp — omit to let the agent choose
